{
  "name": "rongwang-health-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --test --import tsx",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke-fast-funnel.mjs",
    "acceptance": "node scripts/acceptance-fast-funnel.mjs",
    "customer:smoke": "node scripts/customer-journey-smoke.mjs",
    "compliance:scan": "node scripts/compliance-scan.mjs",
    "deploy:check": "node scripts/deploy-check.mjs",
    "release:gate": "node scripts/release-gate.mjs",
    "release-log:check": "node scripts/release-log-check.mjs",
    "release:verify": "npm run deploy:check && npm run release:gate && npm run typecheck && npm test && npm run build && npm run lint && npm run compliance:scan",
    "release:smoke": "npm run smoke && npm run acceptance && npm run customer:smoke"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.7",
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
